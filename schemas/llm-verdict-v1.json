{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-verdict-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "reason_code", "source_citations", "explanation", "essential_unknowns", "confidence"],
  "properties": {
    "schema_version": {"const": "llm-verdict-v1"},
    "verdict": {"enum": ["KEEP", "SUPPRESS_CANDIDATE", "UNCERTAIN"]},
    "reason_code": {"type": ["string", "null"], "enum": ["EFFECTIVE_SANITIZER", "CONTROLLED_SOURCE", "INFEASIBLE_PATH", "UNREACHABLE_CODE", "RULE_MISMATCH", null]},
    "source_citations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start_line", "end_line", "claim"], "properties": {"start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "claim": {"type": "string", "minLength": 1}}}},
    "explanation": {"type": "string", "minLength": 1},
    "essential_unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
