{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "confidence", "source", "sink", "dataflow", "barriers", "required_conditions", "missing_evidence", "knowledge_used", "reason"],
  "properties": {
    "schema_version": {"const": "verdict-v2"},
    "verdict": {"enum": ["TRUE_POSITIVE", "FALSE_POSITIVE", "UNCERTAIN"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"$ref": "#/$defs/evidence"},
    "sink": {"$ref": "#/$defs/evidence"},
    "dataflow": {"type": "object", "additionalProperties": false, "required": ["reaches_sink", "evidence_lines"], "properties": {"reaches_sink": {"type": "boolean"}, "evidence_lines": {"$ref": "#/$defs/line_refs"}}},
    "barriers": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/barrier"}},
    "required_conditions": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
    "knowledge_used": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 600}
  },
  "$defs": {"line_refs": {"type": "array", "maxItems": 4, "items": {"type": "string", "pattern": "^F[1-9][0-9]*:L[1-9][0-9]*$"}}, "evidence": {"type": "object", "additionalProperties": false, "required": ["present", "evidence_lines"], "properties": {"present": {"type": "boolean"}, "evidence_lines": {"$ref": "#/$defs/line_refs"}}}, "barrier": {"type": "object", "additionalProperties": false, "required": ["kind", "effective", "evidence_lines", "reason"], "properties": {"kind": {"enum": ["PATH_PREFIX_CHECK", "OTHER"]}, "effective": {"type": "boolean"}, "evidence_lines": {"$ref": "#/$defs/line_refs"}, "reason": {"type": "string", "minLength": 1, "maxLength": 300}}}}
}
